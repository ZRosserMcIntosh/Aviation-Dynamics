 "reference_aircraft": "Boeing 737-800 (2 x CFM International CFM56-7B26), narrow-body airliner",
 "description": "737-800: generated by tools/jetgen from published figures (dimensions, wing area and sweep, weights, fuel, engines, speed limits, flap settings) on the Top G's validated arrangement, then calibrated (see provenance).",
 "sources": [
  {
   "id": "QANTAS",
   "citation": "Qantas, Boeing 737-800 fact sheet (MTOW 79,015 kg, wing area 124.6 m2, fuel ~26,025 L, CFM56-7B26 116.99 kN)."
  },
  {
   "id": "BOEING",
   "citation": "Boeing 737 airplane characteristics for airport planning (dimensions, MLW 146,300 lb, OEW ~91,300 lb) as commonly reproduced."
  },
  {
   "id": "MATTINGLY",
   "citation": "J. D. Mattingly, Elements of Gas Turbine Propulsion (McGraw-Hill, 1996), eq. 2.54a: installed thrust lapse of a high-bypass turbofan."
  },
  {
   "id": "ROSKAM",
   "citation": "J. Roskam, Airplane Design Part V/VI: radii of gyration and drag build-up for business jets."
  },
  {
   "id": "EST",
   "citation": "Engineering estimate for this simulation (no published source); see the note."
  }
 ],
 "provenance": [
  {
   "field": "reference, mass.max_*, fuel, turbofans[*].static_thrust_kn",
   "kind": "published",
   "source": "QANTAS",
   "note": "Span 35.79 m, wing area 124.6 m2, length 39.47 m; MTOW 174200 lb, MLW 146300 lb, empty 91300 lb (BOW less crew where only BOW is published), 26300 lbf a side (see sources)."
  },
  {
   "field": "surfaces[0]",
   "kind": "estimated",
   "source": "EST",
   "note": "The Top G's planform family (crank at 28 % semi-span, taper, washout, twist, sections, flap/aileron/spoiler layout) at this type's span, area and 25.0 deg quarter-chord sweep with winglets."
  },
  {
   "field": "surfaces[1], surfaces[2]",
   "kind": "estimated",
   "source": "EST",
   "note": "Tail areas from the Top G's volume coefficients at this type's arms (Vh 0.69; Vv 0.077: the Top G's 0.058 plus what this fuselage's extra destabilising moment needs); low-set tail."
  },
  {
   "field": "controls.yaw_damper",
   "kind": "estimated",
   "source": "EST",
   "note": "Yaw damper (these types have one): washed-out yaw rate (3 s) to the rudder, 2 per rad/s at 160 KEAS scheduled with 1/EAS^2, 30 % authority."
  },
  {
   "field": "mass.empty_cg_m, mass.cg_*_limit, gear",
   "kind": "estimated",
   "source": "EST",
   "note": "Empty CG 27 % MAC, CG limits 7-11 % to 36 % MAC, main gear at 45 % MAC (the Top G arrangement); inertia scaled by mass and size."
  },
  {
   "field": "drag_items, turbofans[*].fan_diameter_m, turbofans[*].windmill_drag_area_m2",
   "kind": "estimated",
   "source": "ROSKAM",
   "note": "The Top G build-up scaled with fuselage wetted area, nacelle size and wing area; the fan and its windmilling drag area with the nacelle."
  },
  {
   "field": "electrical",
   "kind": "estimated",
   "source": "EST",
   "note": "Two engine-driven generators (GEN 1, GEN 2) of 600 A each at 28 V, on line from 45 % N2 (the 737-800 has two 90 kVA 115 V AC IDGs, modelled as their 28 V DC bus equivalent); battery 48 Ah; the Top G's loads (same names) at 1.6 x its currents for this airframe class."
  },
  {
   "field": "hydraulics",
   "kind": "estimated",
   "source": "EST",
   "note": "The Top G's two-system layout at 3,000 psi: A on engine 1, B on engine 2, an electric pump of 120 A on generator power on both; gear, flaps, speedbrake, steering and brakes on either system, a brake accumulator for 6 applications, gear free fall at 35 % rate (the 737 has an engine pump and an electric pump on each of A and B, as here; the standby system is not modelled)."
  },
  {
   "field": "controls.speedbrake, turbofans[*].thrust_reverser",
   "kind": "published",
   "source": "BOEING",
   "note": "Speedbrake with automatic ground spoilers; cascade thrust reversers (estimated effectiveness and schedule)."
  },
  {
   "field": "limits, controls.flap_detents_deg",
   "kind": "published",
   "source": "BOEING",
   "note": "VMO 340 KIAS, MMO 0.82; flaps [0, 1, 5, 15, 25, 30, 40] with VFE [250, 250, 200, 190, 175, 162] (some flap placards estimated)."
  },
  {
   "field": "turbofans[*].lapse_mach_coefficient",
   "kind": "calibrated",
   "source": "MATTINGLY",
   "note": "0.507 (Mattingly's lapse law) so the maximum level speed at full thrust at FL350 is the published maximum cruise 460 KTAS (sim 460 KTAS, M 0.798)."
  }
 ],
