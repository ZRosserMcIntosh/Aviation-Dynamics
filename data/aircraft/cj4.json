 "description": "Citation CJ4: generated by tools/jetgen from published figures (dimensions, wing area and sweep, weights, fuel, engines, speed limits, flap settings) on the Top G's validated arrangement, then calibrated (see provenance).",
 "sources": [
  {
   "id": "TXT",
   "citation": "Textron Aviation, Citation CJ4 product pages (wing area 330 sq ft)."
  },
  {
   "id": "JETCRAFT",
   "citation": "JetCraft, Cessna Citation CJ4 overview (FJ44-4A 3,621 lbf, MTOW 17,110 lb, MLW 15,660 lb, BOW 10,280 lb)."
  },
  {
   "id": "GLOBALAIR",
   "citation": "GlobalAir, Citation CJ4 Gen 2 specifications (fuel 5,828 lb)."
  },
  {
   "id": "TT",
   "citation": "Twin & Turbine (June 2015): speedbrakes on a lever by the throttles, ground spoilers after touchdown."
  },
  {
   "id": "MATTINGLY",
   "citation": "J. D. Mattingly, Elements of Gas Turbine Propulsion (McGraw-Hill, 1996), eq. 2.54a: installed thrust lapse of a high-bypass turbofan."
  },
  {
   "id": "ROSKAM",
   "citation": "J. Roskam, Airplane Design Part V/VI: radii of gyration and drag build-up for business jets."
  },
  {
   "id": "EST",
   "citation": "Engineering estimate for this simulation (no published source); see the note."
  }
 ],
 "provenance": [
  {
   "field": "reference, mass.max_*, fuel, turbofans[*].static_thrust_kn",
   "kind": "published",
   "source": "TXT",
   "note": "Span 15.49 m, wing area 30.66 m2, length 16.26 m; MTOW 17110 lb, MLW 15660 lb, empty 9905 lb (BOW less crew where only BOW is published), 3621 lbf a side (see sources)."
  },
  {
   "field": "surfaces[0]",
   "kind": "estimated",
   "source": "EST",
   "note": "The Top G's planform family (crank at 28 % semi-span, taper, washout, twist, sections, flap/aileron/spoiler layout) at this type's span, area and 12.5 deg quarter-chord sweep."
  },
  {
   "field": "surfaces[1], surfaces[2]",
   "kind": "estimated",
   "source": "EST",
   "note": "Tail areas from the Top G's volume coefficients at this type's arms (Vh 0.69; Vv 0.067: the Top G's 0.058 plus what this fuselage's extra destabilising moment needs); low-set tail."
  },
  {
   "field": "controls.yaw_damper",
   "kind": "estimated",
   "source": "EST",
   "note": "Yaw damper (these types have one): washed-out yaw rate (3 s) to the rudder, 2 per rad/s at 160 KEAS scheduled with 1/EAS^2, 30 % authority."
  },
  {
   "field": "mass.empty_cg_m, mass.cg_*_limit, gear",
   "kind": "estimated",
   "source": "EST",
   "note": "Empty CG 27 % MAC, CG limits 7-11 % to 36 % MAC, main gear at 45 % MAC (the Top G arrangement); inertia scaled by mass and size."
  },
  {
   "field": "drag_items, turbofans[*].fan_diameter_m, turbofans[*].windmill_drag_area_m2",
   "kind": "estimated",
   "source": "ROSKAM",
   "note": "The Top G build-up scaled with fuselage wetted area, nacelle size and wing area; the fan and its windmilling drag area with the nacelle."
  },
  {
   "field": "electrical",
   "kind": "estimated",
   "source": "EST",
   "note": "Two engine-driven generators (GEN 1, GEN 2) of 300 A each at 28 V, on line from 45 % N2 (two 300 A starter-generators, typical of the light-jet class); battery 44 Ah; the Top G's loads (same names) at 0.8 x its currents for this airframe class."
  },
  {
   "field": "hydraulics",
   "kind": "estimated",
   "source": "EST",
   "note": "The Top G's two-system layout at 3,000 psi: A on engine 1, B on engine 2, an electric pump of 60 A on generator power on A; gear, flaps, speedbrake, steering and brakes on either system, a brake accumulator for 6 applications, gear free fall at 35 % rate (the CJ4 has one engine-pump system; two systems is the template layout)."
  },
  {
   "field": "controls.speedbrake, turbofans[*].thrust_reverser",
   "kind": "published",
   "source": "TT",
   "note": "Speedbrake with automatic ground spoilers; no thrust reversers."
  },
  {
   "field": "limits, controls.flap_detents_deg",
   "kind": "published",
   "source": "TT",
   "note": "VMO 305 KIAS, MMO 0.77; flaps [0, 15, 35] with VFE [200, 161] (some flap placards estimated)."
  },
  {
   "field": "surfaces[0].panels[*].controls[flap].clmax_increment_ratio",
   "kind": "calibrated",
   "source": "EST",
   "note": "0.256 so the landing-flap stall speed at 15660 lb is 86.2 KCAS (Vref 112 KIAS (Aerocorner; weight not stated, taken at MLW 15,660 lb; unverified), VSO = Vref / 1.3); the Top G layout gave 72.2."
  },
  {
   "field": "turbofans[*].lapse_mach_coefficient",
   "kind": "calibrated",
   "source": "MATTINGLY",
   "note": "0.393 (Mattingly's lapse law) so the maximum level speed at full thrust at FL300 is the published maximum cruise 451 KTAS (sim 451 KTAS, M 0.765)."
  }
 ],
