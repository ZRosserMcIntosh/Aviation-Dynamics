 "id": "crj700",
 "display_name": "CRJ700",
 "manufacturer": "Bombardier (now Mitsubishi)",
 "reference_aircraft": "Bombardier CRJ700 (CL-600-2C10, 2 x GE CF34-8C5), 70-seat regional jet",
 "description": "CRJ700: generated by tools/jetgen from published figures (dimensions, wing area and sweep, weights, fuel, engines, speed limits, flap settings) on the Top G's validated arrangement, then calibrated (see provenance).",
 "sources": [
  {
   "id": "FLYRADIUS",
   "citation": "FlyRadius, Bombardier CRJ700 specifications (MTOW 75,000 lb ER, MLW 67,000 lb, fuel 19,450 lb)."
  },
  {
   "id": "GLOBALAIR",
   "citation": "GlobalAir, CRJ-700 specifications (operating weight 44,245 lb)."
  },
  {
   "id": "WIKI",
   "citation": "Wikipedia, Bombardier CRJ (CF34-8C5 13,790 lbf flat-rated, wing area 760 sq ft)."
  },
  {
   "id": "FORUM",
   "citation": "Airline-pilot forum quoting the CRJ-701ER handbook: Vref flaps 45 135 KIAS at 67,000 lb (secondary)."
  },
  {
   "id": "MATTINGLY",
   "citation": "J. D. Mattingly, Elements of Gas Turbine Propulsion (McGraw-Hill, 1996), eq. 2.54a: installed thrust lapse of a high-bypass turbofan."
  },
  {
   "id": "ROSKAM",
   "citation": "J. Roskam, Airplane Design Part V/VI: radii of gyration and drag build-up for business jets."
  },
  {
   "id": "EST",
   "citation": "Engineering estimate for this simulation (no published source); see the note."
  }
 ],
 "provenance": [
  {
   "field": "reference, mass.max_*, fuel, turbofans[*].static_thrust_kn",
   "kind": "published",
   "source": "FLYRADIUS",
   "note": "Span 23.24 m, wing area 70.6 m2, length 32.51 m; MTOW 75000 lb, MLW 67000 lb, empty 44245 lb (BOW less crew where only BOW is published), 13790 lbf a side (see sources)."
  },
  {
   "field": "surfaces[0]",
   "kind": "estimated",
   "source": "EST",
   "note": "The Top G's planform family (crank at 28 % semi-span, taper, washout, twist, sections, flap/aileron/spoiler layout) at this type's span, area and 26.9 deg quarter-chord sweep with winglets."
  },
  {
   "field": "surfaces[1], surfaces[2]",
   "kind": "estimated",
   "source": "EST",
   "note": "Tail areas from the Top G's volume coefficients at this type's arms (Vh 0.69; Vv 0.082: the Top G's 0.058 plus what this fuselage's extra destabilising moment needs); T-tail."
  },
  {
   "field": "controls.yaw_damper",
   "kind": "estimated",
   "source": "EST",
   "note": "Yaw damper (these types have one): washed-out yaw rate (3 s) to the rudder, 2 per rad/s at 160 KEAS scheduled with 1/EAS^2, 30 % authority."
  },
  {
   "field": "mass.empty_cg_m, mass.cg_*_limit, gear",
   "kind": "estimated",
   "source": "EST",
   "note": "Empty CG 27 % MAC, CG limits 7-11 % to 36 % MAC, main gear at 45 % MAC (the Top G arrangement); inertia scaled by mass and size."
  },
  {
   "field": "drag_items, turbofans[*].fan_diameter_m, turbofans[*].windmill_drag_area_m2",
   "kind": "estimated",
   "source": "ROSKAM",
   "note": "The Top G build-up scaled with fuselage wetted area, nacelle size and wing area; the fan and its windmilling drag area with the nacelle."
  },
  {
   "field": "electrical",
   "kind": "estimated",
   "source": "EST",
   "note": "Two engine-driven generators (GEN 1, GEN 2) of 400 A each at 28 V, on line from 45 % N2 (the CRJ700 has two 30 kVA 115 V AC IDGs, modelled as their 28 V DC bus equivalent); battery 43 Ah; the Top G's loads (same names) at 1.3 x its currents for this airframe class."
  },
  {
   "field": "hydraulics",
   "kind": "estimated",
   "source": "EST",
   "note": "The Top G's two-system layout at 3,000 psi: A on engine 1, B on engine 2, an electric pump of 80 A on generator power on A; gear, flaps, speedbrake, steering and brakes on either system, a brake accumulator for 6 applications, gear free fall at 35 % rate (the CRJ700 has three systems (1 and 2 engine-driven with AC pumps, 3 on AC pumps only); two engine-driven systems is a simplification)."
  },
  {
   "field": "controls.speedbrake, turbofans[*].thrust_reverser",
   "kind": "published",
   "source": "FORUM",
   "note": "Speedbrake with automatic ground spoilers; cascade thrust reversers (estimated effectiveness and schedule)."
  },
  {
   "field": "limits, controls.flap_detents_deg",
   "kind": "published",
   "source": "FORUM",
   "note": "VMO 335 KIAS, MMO 0.85; flaps [0, 1, 8, 20, 30, 45] with VFE [230, 230, 220, 185, 170] (some flap placards estimated)."
  },
  {
   "field": "surfaces[0].panels[*].controls[flap].clmax_increment_ratio",
   "kind": "calibrated",
   "source": "EST",
   "note": "0.641 so the landing-flap stall speed at 67000 lb is 109.8 KCAS (Vref flaps 45 135 KIAS at 67,000 lb (pilot forum quoting the CRJ-701ER handbook), VSR = Vref / 1.23); the Top G layout gave 103.1."
  },
  {
   "field": "turbofans[*].lapse_mach_coefficient",
   "kind": "calibrated",
   "source": "MATTINGLY",
   "note": "0.440 (Mattingly's lapse law) so the maximum level speed at full thrust at FL370 is the published maximum cruise 473 KTAS (sim 473 KTAS, M 0.825)."
  }
 ],
