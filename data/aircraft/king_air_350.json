{
 "schema_version": 1,
 "id": "king_air_350",
 "display_name": "King Air 350",
 "manufacturer": "Beechcraft",
 "reference_aircraft": "Beechcraft King Air 350 (B300; 2 x Pratt & Whitney Canada PT6A-60A, Hartzell 4-blade propellers), twin-turboprop business aircraft",
 "description": "Twin-turboprop, low-wing, T-tail business aircraft with winglets: the project's first turboprop. Free-turbine PT6A-60A engines (gas generator, ITT, torque, flat rating) drive constant-speed, feathering and reversing propellers through their governors. From public specifications and published performance; geometry from three-views. Structural frame: origin at the nose tip, x forward, y right, z down (metres); the fuselage centreline is z = 0.",
 "sources": [
  {
   "id": "SPEC",
   "citation": "Beechcraft King Air 350/350i published specifications (manufacturer brochures and Jane's All the World's Aircraft): dimensions (span 57 ft 11 in, length 46 ft 8 in, height 14 ft 4 in, wing area 310 ft^2), weights (MTOW 15,000 lb, max ramp 15,100 lb, MZFW 12,500 lb), usable fuel 539 US gal, performance (maximum cruise ~303-312 KTAS in the FL240-FL280 band at mid weight, sea-level rate of climb ~2,700 fpm, take-off over 50 ft ~3,300 ft, landing ~2,700 ft, ceiling 35,000 ft)."
  },
  {
   "id": "TCDS",
   "citation": "FAA Type Certificate Data Sheet A24CE (Beech 300 series, King Air 350 = B300): engines 2 x P&WC PT6A-60A, propellers Hartzell 4-blade 105 in, 1,700 rpm; Vmo 263 KIAS, Mmo 0.58; flap and gear speeds (VFE approach 202 / full 158 KIAS, VLE 184 KIAS); Vmca 94 KIAS."
  },
  {
   "id": "ENG",
   "citation": "Pratt & Whitney Canada PT6A-60A (Transport Canada / EASA TCDS E.008 class data; Jane's Aero-Engines): 1,050 shp flat-rated take-off and maximum continuous at 1,700 propeller rpm, SFC 0.548 lb/shp/h at take-off, maximum ITT 820 degC, gas generator 100 % = 37,468 rpm, Ng limit 104 %."
  },
  {
   "id": "NACA",
   "citation": "Abbott & von Doenhoff, Theory of Wing Sections (1959): NACA 23018 (root) to 23012 (tip) section data; the King Air wing family's sections."
  },
  {
   "id": "ROSKAM",
   "citation": "J. Roskam, Airplane Design Part V/VI: radii of gyration (twin turboprops) and component drag build-up."
  },
  {
   "id": "SARAVANAMUTTOO",
   "citation": "Saravanamuttoo, Rogers & Cohen, Gas Turbine Theory (5th ed.), ch. 9: free-turbine torque-speed characteristic, corrected (non-dimensional) parameters, off-design matching."
  },
  {
   "id": "EST",
   "citation": "Engineering estimate for this simulation (no published source); see the note."
  }
 ],
 "provenance": [
  {
   "field": "reference",
