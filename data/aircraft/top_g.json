  {
   "field": "mass.empty_inertia_kgm2",
   "kind": "estimated",
   "source": "ROSKAM",
   "note": "Business-jet radii of gyration Rx 0.30, Ry 0.33, Rz 0.45."
  },
  {
   "field": "surfaces",
   "kind": "estimated",
   "source": "EST",
   "note": "Planform matching the published area and span; quarter-chord sweep 27/33 deg; supercritical section polar; Fowler-flap gains raised to stand for the chord extension the strip model does not represent (approach speeds near the published ~115-125 KIAS)."
  },
  {
   "field": "turbofans",
   "kind": "published",
   "source": "ENG",
   "note": "Take-off thrust and bypass ratio published; lapse coefficient 0.18 (Mattingly's 0.49 for airliner engines) calibrated so Mach 0.85 is available up to FL510 at mid weight (max-cruise thrust near the ceiling); TSFC 0.39 static / ~0.60 cruise (Estimated)."
  },
  {
   "field": "drag_items",
   "kind": "estimated",
   "source": "ROSKAM",
   "note": "Equivalent flat-plate areas from a wetted-area build-up (CD0 ~ 0.018); fuselage and nacelle transonic drag rise from Mcrit 0.86 / 0.84 (Estimated)."
  },
  {
   "field": "limits",
   "kind": "published",
   "source": "SPEC",
   "note": "Vmo 340 KCAS, Mmo 0.925; flap speeds 250/220/170 KCAS (10/20/39 deg) and VLE 250 KCAS are representative (Estimated)."
  },
  {
   "field": "controls.rudder_limiter_kias",
   "kind": "estimated",
   "source": "EST",
   "note": "Rudder travel limiter: full 25 deg travel to 160 KEAS, then scaled with 1/q (about 10 deg at 250 KEAS), typical of business jets with a rudder limiter."
  },
  {
   "field": "gear",
   "kind": "estimated",
   "source": "EST",
   "note": "Oleo stiffness and damping sized for static deflection ~0.14 m and ~0.4 critical damping at MTOW."
  },
  {
   "field": "gear.nose.steering",
   "kind": "estimated",
   "source": "EST",
   "note": "Hydraulic nose-wheel steering: tiller +-80 deg (typical of large business jets; G650 figure not public), rudder pedals +-10 deg. Actuator slew 20 deg/s, estimated."
  }
