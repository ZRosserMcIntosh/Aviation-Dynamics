 "sources": [
  {
   "id": "SPEC",
   "citation": "Manufacturer's published G650ER specifications (dimensions, weights, fuel capacity, range, Mmo, ceiling) and EASA/FAA type certificate data sheet T00015AT (G650 series: Vmo 340 KCAS, Mmo 0.925, flap and gear speeds)."
  },
  {
   "id": "ENG",
   "citation": "EASA type certificate data sheet E.088 (Rolls-Royce Deutschland BR700-725A1-12): take-off thrust 75.2 kN (16,900 lbf); bypass ratio 4.4 (manufacturer)."
  },
  {
   "id": "MATTINGLY",
   "citation": "J. D. Mattingly, Elements of Gas Turbine Propulsion (McGraw-Hill, 1996), eq. 2.54a: installed thrust lapse of a high-bypass turbofan."
  },
  {
   "id": "ROSKAM",
   "citation": "J. Roskam, Airplane Design Part V/VI: radii of gyration and drag build-up for business jets."
  },
  {
   "id": "EST",
   "citation": "Engineering estimate for this simulation (no published source); see the note."
  }
