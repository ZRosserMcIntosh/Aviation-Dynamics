 "provenance": [
  {
   "field": "reference, mass.max_*, fuel, turbofans[*].static_thrust_kn",
   "kind": "published",
   "source": "AEROPEDIA",
   "note": "Span 14.58 m, wing area 28.95 m2, length 17.68 m; MTOW 20500 lb, MLW 19200 lb, empty 13500 lb (BOW less crew where only BOW is published), 3500 lbf a side (see sources)."
  },
  {
   "field": "surfaces[0]",
   "kind": "estimated",
   "source": "EST",
   "note": "The Top G's planform family (crank at 28 % semi-span, taper, washout, twist, sections, flap/aileron/spoiler layout) at this type's span, area and 13.0 deg quarter-chord sweep with winglets."
  },
  {
   "field": "surfaces[1], surfaces[2]",
   "kind": "estimated",
   "source": "EST",
   "note": "Tail areas from the Top G's volume coefficients at this type's arms (Vh 0.69; Vv 0.078: the Top G's 0.058 plus what this fuselage's extra destabilising moment needs); T-tail."
  },
  {
   "field": "controls.yaw_damper",
   "kind": "estimated",
   "source": "EST",
   "note": "Yaw damper (these types have one): washed-out yaw rate (3 s) to the rudder, 2 per rad/s at 160 KEAS scheduled with 1/EAS^2, 30 % authority."
  },
  {
   "field": "mass.empty_cg_m, mass.cg_*_limit, gear",
   "kind": "estimated",
   "source": "EST",
   "note": "Empty CG 27 % MAC, CG limits 7-11 % to 36 % MAC, main gear at 45 % MAC (the Top G arrangement); inertia scaled by mass and size."
  },
  {
   "field": "drag_items, turbofans[*].fan_diameter_m, turbofans[*].windmill_drag_area_m2",
   "kind": "estimated",
   "source": "ROSKAM",
   "note": "The Top G build-up scaled with fuselage wetted area, nacelle size and wing area; the fan and its windmilling drag area with the nacelle."
  },
  {
   "field": "electrical",
   "kind": "estimated",
   "source": "EST",
   "note": "Two engine-driven generators (GEN 1, GEN 2) of 300 A each at 28 V, on line from 45 % N2 (two 300 A starter-generators (the type has two 24 V batteries, modelled as one)); battery 40 Ah; the Top G's loads (same names) at 0.9 x its currents for this airframe class."
  },
  {
   "field": "hydraulics",
   "kind": "estimated",
   "source": "EST",
   "note": "The Top G's two-system layout at 3,000 psi: A on engine 1, B on engine 2, an electric pump of 60 A on generator power on A; gear, flaps, speedbrake, steering and brakes on either system, a brake accumulator for 6 applications, gear free fall at 35 % rate (the Learjet 45 has one engine-pump system with an electric auxiliary pump; two systems is the template layout)."
  },
  {
   "field": "controls.speedbrake, turbofans[*].thrust_reverser",
   "kind": "published",
   "source": "FLYRADIUS",
   "note": "Speedbrake with automatic ground spoilers; cascade thrust reversers (estimated effectiveness and schedule)."
  },
  {
   "field": "limits, controls.flap_detents_deg",
   "kind": "published",
   "source": "FLYRADIUS",
   "note": "VMO 330 KIAS, MMO 0.81; flaps [0, 8, 20, 40] with VFE [250, 200, 150] (some flap placards estimated)."
  },
  {
   "field": "turbofans[*].lapse_mach_coefficient",
   "kind": "calibrated",
   "source": "MATTINGLY",
   "note": "0.229 (Mattingly's lapse law) so the maximum level speed at full thrust at FL330 is the published maximum cruise 465 KTAS (sim 465 KTAS, M 0.799)."
  }
